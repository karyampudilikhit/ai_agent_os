# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# Local run artifacts
phase4_run.json
*.log

# Benchmark scratch (raw judge splits, crash dumps, one-off probes —
# regenerable from the rerun_*.py / build_blind_report_*.py scripts)
judge_tmp/
judge_tmp2/
judge_tmp3/
critique_raw_debug*.txt
gptoss_test.txt
context_share_summary.txt

# CLI test outputs (regenerable by running validate_idea.py; not source)
verdict_test.md
verdict_*.md

# Employee runtime memory (real founders' idea/task history — personal
# and business data, not source; regenerated fresh per employee_id)
backend/app/employees/data/

# Persisted team specs per session (same reason: personal roster data,
# regenerated per session via the spawner or hand-editing in the UI).
# Also contains _mcp_connections.json which can hold API tokens in
# each connection's `env` block — never commit.
backend/app/employees/team_data/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
.http_tools.json
backend/app/employees/company_data/
backend/app/employees/data/registry/

# Action layer — pending mutating actions live here as JSON. Can carry
# task-specific args (draft email bodies, Slack messages) — treat like
# .http_tools.json, never commit.
.pending_actions.json

# Sandboxed workspace where the AI writes files via action.write_file.
# Contents are user work product, not source.
workspace/

# Browser automation profile — holds REAL login cookies/session state for
# whatever sites the founder logged into (GitHub etc). Never commit.
browser_profile/

# OAuth access tokens (live credentials — can create/delete repos)
.oauth_tokens.json

# Pending approval queue (may embed action arguments incl. secrets)
.pending_actions.json
